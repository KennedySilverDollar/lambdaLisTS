;; money.lts
(type Money (obj (amount : number) (currency : string)))
(export add-money zero)
(defn zero () : Money
  (obj (amount 0) (currency "JPY")))
(defn add-money (a : Money) (b : Money) : (Result Money string)
  (if (= a.currency b.currency) (ok (obj (amount (+ a.amount b.amount)) (currency a.currency))) (err (str-concat "currency mismatch: " a.currency " vs " b.currency))))
(example (add-money (obj (amount 1) (currency "JPY")) (obj (amount 2) (currency "JPY")))
  => (ok (obj (amount 3) (currency "JPY"))))
(prop "add-money commutative" (forall [(a : number) (b : number)] (= (add-money (obj (amount a) (currency "JPY")) (obj (amount b) (currency "JPY"))) (add-money (obj (amount b) (currency "JPY")) (obj (amount a) (currency "JPY"))))))
;; prop はP0では受理のみ。評価はP1
