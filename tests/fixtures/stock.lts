;; B-1 stock.lts（T2 用：網羅性欠落）
(type StockError
  (union
    (obj (tag "OutOfStock"))
    (obj (tag "PriceChanged") (new-price : number))))

(export show-error)

(defn show-error (e : StockError) : string
  (match e
    [(obj (tag "PriceChanged") (new-price p))
     (str-concat "price changed: " (str p))]))
