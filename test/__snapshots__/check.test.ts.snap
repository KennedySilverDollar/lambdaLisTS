exports[`付録A: 型検査ゼロ診断 + type-of ゴールデン > cart.lts（import + do のエラー型 unify + match）も診断ゼロ 1`] = `
{
  "add-money": "(fn ((obj (amount : number) (currency : string)) (obj (amount : number) (currency : string))) : (Result (obj (amount : number) (currency : string)) string))",
  "check-items": "(fn ((Array (obj (id : string) (price : (obj (amount : number) (currency : string))) (qty : number)))) : (Result nil (union (obj (id : string) (tag "NegativeQty")) (obj (tag "EmptyCart")))))",
  "place-order": "(fn ((Array (obj (id : string) (price : (obj (amount : number) (currency : string))) (qty : number)))) : (Result (obj (amount : number) (currency : string)) (union (obj (id : string) (tag "NegativeQty")) (obj (tag "EmptyCart")) string)))",
  "total": "(fn ((Array (obj (id : string) (price : (obj (amount : number) (currency : string))) (qty : number)))) : (Result (obj (amount : number) (currency : string)) string))",
  "zero": "(fn () : (obj (amount : number) (currency : string)))",
}
`;

exports[`付録A: 型検査ゼロ診断 + type-of ゴールデン > money.lts 1`] = `
{
  "add-money": "(fn ((obj (amount : number) (currency : string)) (obj (amount : number) (currency : string))) : (Result (obj (amount : number) (currency : string)) string))",
